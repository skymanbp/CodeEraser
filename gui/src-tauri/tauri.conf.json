{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeEraser",
  "version": "0.0.1",
  "identifier": "dev.codeeraser.gui",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CodeEraser — structure",
        "width": 1280,
        "height": 840
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "dmg"],
    "icon": ["icons/icon.ico"]
  }
}
