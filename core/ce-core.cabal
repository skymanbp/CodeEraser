cabal-version:      3.0
name:               ce-core
version:            0.0.1
synopsis:           CodeEraser judgment core (NDJSON envelope + judgment types)
license:            Apache-2.0
author:             skymanbp
build-type:         Simple

executable ce-core
    main-is:          Main.hs
    hs-source-dirs:   app
    other-modules:    CE.Handshake, CE.Protocol, CE.FourClass,
                      CE.FourClass.Wire, CE.FourClass.Cost,
                      CE.FourClass.Anchor, CE.FourClass.Provenance,
                      CE.FourClass.Verdict, CE.Graph, CE.Graph.Cost,
                      CE.Graph.Build, CE.Graph.Dead, CE.Graph.Cycles,
                      CE.Graph.Position, CE.Clone, CE.Clone.Cost,
                      CE.Clone.Prefilter, CE.Clone.Ted,
                      CE.Docdup, CE.Docdup.Cost, CE.Docdup.Jaccard,
                      CE.Scan, CE.Scan.Cost, CE.Structure,
                      CE.Structure.Axes, CE.Structure.Cost,
                      CE.Structure.Entropy, CE.Wire,
                      CE.Verdict, CE.Verdict.Cost, CE.Verdict.Join,
                      CE.Verdict.Score, CE.Verdict.Ratchet,
                      CE.Verdict.Table, CE.Verdict.Wire
    build-depends:
        base       >=4.19 && <5,
        aeson      >=2.2,
        array      >=0.5,
        bytestring >=0.11,
        containers >=0.7
    default-language: GHC2021
    ghc-options:      -Wall -Werror

-- base-only deterministic checks (plan 搂7.3 as amended 2026-08-11:
-- no RNG inside a byte-determinism contract; Hedgehog is not in the
-- freeze). Recompiling the app modules here is cheaper than a
-- library restructure for one milestone.
test-suite ce-core-test
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   app, test
    other-modules:    CE.Handshake, CE.Protocol, CE.FourClass,
                      CE.FourClass.Wire, CE.FourClass.Cost,
                      CE.FourClass.Anchor, CE.FourClass.Provenance,
                      CE.FourClass.Verdict, CE.Graph, CE.Graph.Cost,
                      CE.Graph.Build, CE.Graph.Dead, CE.Graph.Cycles,
                      CE.Graph.Position, CE.Clone, CE.Clone.Cost,
                      CE.Clone.Prefilter, CE.Clone.Ted,
                      CE.Docdup, CE.Docdup.Cost, CE.Docdup.Jaccard,
                      CE.Scan, CE.Scan.Cost, CE.Structure,
                      CE.Structure.Axes, CE.Structure.Cost,
                      CE.Structure.Entropy, CE.Wire,
                      CE.Verdict, CE.Verdict.Cost, CE.Verdict.Join,
                      CE.Verdict.Score, CE.Verdict.Ratchet,
                      CE.Verdict.Table, CE.Verdict.Wire,
                      Reference, ReferenceGraph, GraphProps,
                      ReferenceTed, CloneProps, ReferenceJaccard,
                      EntropyProps, JoinProps, ScanProps,
                      StructureProps, VerdictProps,
                      VerdictWireProps, WireHarness
    build-depends:
        base       >=4.19 && <5,
        aeson      >=2.2,
        array      >=0.5,
        bytestring >=0.11,
        containers >=0.7
    default-language: GHC2021
    ghc-options:      -Wall -Werror
