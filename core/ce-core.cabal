cabal-version:      3.0
name:               ce-core
-- tracks the product version (one release train with cli/Cargo.toml;
-- pinned by cli's version_mirrors_move_with_the_crate) — the 0.0.1
-- era shipped a v0.2.0 asset that self-reported 0.0.1
version:            1.5.0
synopsis:           CodeEraser judgment core (NDJSON envelope + judgment types)
license:            Apache-2.0
author:             skymanbp
build-type:         Simple

executable ce-core
    main-is:          Main.hs
    hs-source-dirs:   app
    autogen-modules:  Paths_ce_core
    other-modules:    Paths_ce_core,
                      CE.Handshake, CE.Protocol, CE.Protocol.Version, CE.FourClass,
                      CE.FourClass.Wire, CE.FourClass.Cost,
                      CE.FourClass.Anchor, CE.FourClass.Provenance,
                      CE.FourClass.Verdict, CE.Graph, CE.Graph.Cost,
                      CE.Graph.Build, CE.Graph.Dead, CE.Graph.Cycles,
                      CE.Graph.Position, CE.Graph.Contract, CE.Graph.Advisory,
                      CE.Clone, CE.Clone.Cost,
                      CE.Clone.Prefilter, CE.Clone.Ted,
                      CE.Dedup.Cost, CE.Docdup, CE.Docdup.Cost, CE.Docdup.Jaccard,
                      CE.Audit, CE.Audit.Cost,
                      CE.Scan, CE.Scan.Cost, CE.Scan.Cycles, CE.Scan.Fence, CE.Structure,
                      CE.Structure.Axes, CE.Structure.Cost, CE.Structure.Split,
                      CE.Structure.Declared, CE.Structure.Entropy, CE.Structure.Knobs,
                      CE.Structure.Stale,
                      CE.Trend, CE.Trend.Cost, CE.Erase, CE.Erase.Cost, CE.Wire,
                      CE.Verdict, CE.Verdict.Cost, CE.Verdict.Candidates, CE.Verdict.Join,
                      CE.Verdict.Score, CE.Verdict.Ratchet, CE.Verdict.Soft, CE.Verdict.Knobs,
                      CE.Verdict.Table, CE.Verdict.Wire, CE.Verdict.Rows, CE.Verdict.Baseline, CE.Verdict.Faces
    build-depends:
        base       >=4.19 && <5,
        aeson      >=2.2,
        array      >=0.5,
        bytestring >=0.11,
        containers >=0.7
    default-language: GHC2021
    ghc-options:      -Wall -Werror

-- base-only deterministic checks (plan §7.3 as amended 2026-08-11:
-- no RNG inside a byte-determinism contract; Hedgehog is not in the
-- freeze). Recompiling the app modules here is cheaper than a
-- library restructure for one milestone.
test-suite ce-core-test
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   app, test
    autogen-modules:  Paths_ce_core
    other-modules:    Paths_ce_core,
                      CE.Handshake, CE.Protocol, CE.Protocol.Version, CE.FourClass,
                      CE.FourClass.Wire, CE.FourClass.Cost,
                      CE.FourClass.Anchor, CE.FourClass.Provenance,
                      CE.FourClass.Verdict, CE.Graph, CE.Graph.Cost,
                      CE.Graph.Build, CE.Graph.Dead, CE.Graph.Cycles,
                      CE.Graph.Position, CE.Graph.Contract, CE.Graph.Advisory,
                      CE.Clone, CE.Clone.Cost,
                      CE.Clone.Prefilter, CE.Clone.Ted,
                      CE.Dedup.Cost, CE.Docdup, CE.Docdup.Cost, CE.Docdup.Jaccard,
                      CE.Audit, CE.Audit.Cost,
                      CE.Scan, CE.Scan.Cost, CE.Scan.Cycles, CE.Scan.Fence, CE.Structure,
                      CE.Structure.Axes, CE.Structure.Cost, CE.Structure.Split,
                      CE.Structure.Declared, CE.Structure.Entropy, CE.Structure.Knobs,
                      CE.Structure.Stale,
                      CE.Trend, CE.Trend.Cost, CE.Erase, CE.Erase.Cost, CE.Wire,
                      CE.Verdict, CE.Verdict.Cost, CE.Verdict.Candidates, CE.Verdict.Join,
                      CE.Verdict.Score, CE.Verdict.Ratchet, CE.Verdict.Soft, CE.Verdict.Knobs,
                      CE.Verdict.Table, CE.Verdict.Wire, CE.Verdict.Rows, CE.Verdict.Baseline, CE.Verdict.Faces,
                      Reference, ReferenceGraph, GraphWireProps, GraphProps, AdvisoryProps,
                      ReferenceTed, CloneProps, ReferenceJaccard,
                      AuditProps, EntropyProps, JoinProps, ScanProps, ScanCyclesProps,
                      StructureProps, TrendProps, EraseProps, VerdictProps,
                      VerdictWireProps, VerdictFenceProps, VerdictKnobProps, SplitProps, WireHarness,
                      ClassProps
    build-depends:
        base       >=4.19 && <5,
        aeson      >=2.2,
        array      >=0.5,
        bytestring >=0.11,
        containers >=0.7
    default-language: GHC2021
    ghc-options:      -Wall -Werror
