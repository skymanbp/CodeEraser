# CodeEraser binary distribution manifest (ADR-007: SHA256 pinned in
# the plugin manifest). Sourced by bin/ce.sh — plain sh key=value so
# the starter needs no JSON parser. The release flow is two-phase
# (build->pin->tag, docs/RELEASE.md):
# a workflow_dispatch run uploads draft artifacts + SHA256SUMS, the
# measured hashes land HERE in a commit, and only then the tag is cut,
# whose workflow verifies the draft assets against these pins before
# publishing. Empty pins = air-gapped preview stance: ce.sh falls back
# to a manually placed binary or `ce` on PATH and never downloads.

CE_MANIFEST_VERSION="1.10.1"
CE_BASE_URL="https://github.com/skymanbp/CodeEraser/releases/download/v1.10.1"

# Per-platform pins, filled by the release pin commit. Key grammar:
# CE_SHA256_<PLATFORM>_CE where <PLATFORM> is the uname-derived key
# with [a-z-] uppercased to [A-Z_] (see plat_key in ce.sh). The roster
# is update::version::TARGETS — five targets since v1.7.0 (plan v2.29
# step 10, O70).
CE_SHA256_X86_64_WINDOWS_CE="3926c2228507ead9baa11a60bd25edab7bb00be944c86c08d45e8353fb5f8de4"
CE_SHA256_X86_64_LINUX_CE="9771f11a9f779a4da7928a3a95eb30ccb002a608f4181bba48eb1c50b68bdd9c"
CE_SHA256_AARCH64_MACOS_CE="d0b91113aecf9d05fda205a1abfa769a195bf2ea28e66c87a47a0d4c8db12c50"
CE_SHA256_X86_64_MACOS_CE="218aed71a11bfe672cd402ca9476614484aea726166736fc5c97f65777da8c7e"
CE_SHA256_AARCH64_LINUX_CE="9a574424a3e21da7943a96844a7694fa506340303eca8319b94bc793f9dc7fb9"

# ce-core (the Haskell judgment layer) ships beside ce from v0.2.0 —
# ce.sh places it in CLAUDE_PLUGIN_DATA as `ce-core-<version>-<key>`
# (one per plugin version) and binds ce to it by CE_CORE_BIN. Empty pins =
# the core download leg stays off (judgment families then need a
# source-installed ce-core, the pre-v0.2.0 stance).
CE_SHA256_X86_64_WINDOWS_CECORE="f9c6651cc61a1d4d7b7cd99f37e31c09861d489e497c192593fc3595bf8a141c"
CE_SHA256_X86_64_LINUX_CECORE="1f6e37b35db8e7b894c06ce33cd3b6fd71d8d79538b8438150d39b42de18c918"
CE_SHA256_AARCH64_MACOS_CECORE="82bf8f80da34e58e40937a37cdafe94582a0b327c1d4ce9c424d9b1be8f26fea"
CE_SHA256_X86_64_MACOS_CECORE="05aa21a2925850006be1b2a7d66608784c227e0c1f863c7c45946b1d155c5685"
CE_SHA256_AARCH64_LINUX_CECORE="27de91f9f8c8fa8d8a5e46b656e94055c0c17559c1a591251d077fbd6d8d3a32"

# The GUI installers, one per target (pinned since v0.7.3 — acf2095,
# the commit that first committed them; the version these pins
# measure is CE_MANIFEST_VERSION above — no second copy of it here
# to rot): the highest-privilege artifacts in the release — elevated,
# and the Windows one edits the machine PATH — were the only assets
# with no committed pin, checked solely against a SHA256SUMS
# generated by the same mutable draft. The tag phase verifies these
# too, so the trust anchor covers every binary the release ships.
CE_SHA256_X86_64_WINDOWS_SETUP="82fa4a97842c883b3d747eccb76a119516791aa1cd3d86b0fa0207ae2ceab9e4"
CE_SHA256_X86_64_LINUX_APPIMAGE="1bee1bdcb049117fc9195dd11cc5dfc247fda5c0cf0808ce9fd85c3c0117406d"
CE_SHA256_AARCH64_MACOS_DMG="7e9114e18eb3d69f72d5ea0876dd09c65536e34ad7306cec87773186c45c1b17"
CE_SHA256_X86_64_MACOS_DMG="b4cd48baf2217160f88f0490763a993dabe9021a132561d2ddf0d07f36fad0cf"
CE_SHA256_AARCH64_LINUX_APPIMAGE="cfa2a5b0e6a15bf679066a5da76b409c6ba09ad1938f77af08be553042da6a6f"
