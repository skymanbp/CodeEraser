# CodeEraser binary distribution manifest (ADR-007: SHA256 pinned in
# the plugin manifest). Sourced by bin/ce.sh — plain sh key=value so
# the starter needs no JSON parser. The release flow is two-phase
# (build->pin->tag, docs/RELEASE.md):
# a workflow_dispatch run uploads draft artifacts + SHA256SUMS, the
# measured hashes land HERE in a commit, and only then the tag is cut,
# whose workflow verifies the draft assets against these pins before
# publishing. Empty pins = air-gapped preview stance: ce.sh falls back
# to a manually placed binary or `ce` on PATH and never downloads.

CE_MANIFEST_VERSION="0.7.3"
CE_BASE_URL="https://github.com/skymanbp/CodeEraser/releases/download/v0.7.3"

# Per-platform pins, filled by the release pin commit. Key grammar:
# CE_SHA256_<PLATFORM>_CE where <PLATFORM> is the uname-derived key
# with [a-z-] uppercased to [A-Z_] (see plat_key in ce.sh).
CE_SHA256_X86_64_WINDOWS_CE="a66f43f1f7ce2a598fe5398fef767e5b8b04d8bba68b1ad21519cfd22db30ed0"
CE_SHA256_X86_64_LINUX_CE="25e8b1ef4eacbd6a93726d5afd30b7c7687eae7bd34ec3f1832c194cc3ec5de1"
CE_SHA256_AARCH64_MACOS_CE="d0e5ab5238542a9b98c196b176eeacdd2881604fd26612922450793fe173a070"

# ce-core (the Haskell judgment layer) ships beside ce from v0.2.0 —
# ce.sh places it as a plain `ce-core` sibling in CLAUDE_PLUGIN_DATA,
# which is exactly where ce's resolver chain probes. Empty pins =
# the core download leg stays off (judgment families then need a
# source-installed ce-core, the pre-v0.2.0 stance).
CE_SHA256_X86_64_WINDOWS_CECORE="dfa9fb7becdd6d52c82b25adaa487f2b47bdab3e29f154ba3a6cb0449e5342a8"
CE_SHA256_X86_64_LINUX_CECORE="57d1bb0319012abe39aa6d4cef07bcb4406d74459f987d48ba666485e21f180a"
CE_SHA256_AARCH64_MACOS_CECORE="e52c6dae1ce5c97c2c675ee8efdf393da6092e7e7b3871bf8097dba6c17b597f"

# The three GUI installers (v0.7.3): the highest-privilege artifacts in
# the release — elevated, and the Windows one edits the machine PATH —
# were the only assets with no committed pin, checked solely against a
# SHA256SUMS generated by the same mutable draft. The tag phase now
# verifies these too, so the trust anchor covers all nine binaries.
CE_SHA256_X86_64_WINDOWS_SETUP="5c49dac40772ae13bd65c2d8e95cefa3446eb06e45b4765e78ca5e38b8433089"
CE_SHA256_X86_64_LINUX_APPIMAGE="34dfcb9df5a2766de5ec5935f5da6772da79f5ab481c59db1b2dd5e030874bfa"
CE_SHA256_AARCH64_MACOS_DMG="743e4a0920fa139299c79697e33e68681884ef2b5ac9f64938c822b5b902da86"
