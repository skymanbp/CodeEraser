# CodeEraser binary distribution manifest (ADR-007: SHA256 pinned in
# the plugin manifest). Sourced by bin/ce.sh — plain sh key=value so
# the starter needs no JSON parser. The release flow is two-phase
# (build->pin->tag, docs/RELEASE.md):
# a workflow_dispatch run uploads draft artifacts + SHA256SUMS, the
# measured hashes land HERE in a commit, and only then the tag is cut,
# whose workflow verifies the draft assets against these pins before
# publishing. Empty pins = air-gapped preview stance: ce.sh falls back
# to a manually placed binary or `ce` on PATH and never downloads.

CE_MANIFEST_VERSION="1.2.0"
CE_BASE_URL="https://github.com/skymanbp/CodeEraser/releases/download/v1.2.0"

# Per-platform pins, filled by the release pin commit. Key grammar:
# CE_SHA256_<PLATFORM>_CE where <PLATFORM> is the uname-derived key
# with [a-z-] uppercased to [A-Z_] (see plat_key in ce.sh).
CE_SHA256_X86_64_WINDOWS_CE="11e5fee91baa469a2f9734c980b7585a8da79a46f227907f5ef0c75f1b82bd5f"
CE_SHA256_X86_64_LINUX_CE="f72176afa4bdb0dde8d1cf4945817bbfa912f49ec9071650a20ef99317aef416"
CE_SHA256_AARCH64_MACOS_CE="14f7d115cd985e3f4b0072f7a193b4e906e8b7806b2efd5118648002799c3e42"

# ce-core (the Haskell judgment layer) ships beside ce from v0.2.0 —
# ce.sh places it as a plain `ce-core` sibling in CLAUDE_PLUGIN_DATA,
# which is exactly where ce's resolver chain probes. Empty pins =
# the core download leg stays off (judgment families then need a
# source-installed ce-core, the pre-v0.2.0 stance).
CE_SHA256_X86_64_WINDOWS_CECORE="656b3a1378eb305db533e297da875e87f977aa0b35c910c5875ca919b90342a1"
CE_SHA256_X86_64_LINUX_CECORE="b5af627120b931b57e57392f0dc2ad420834f1ee76d7c5799e74b6b588eba13f"
CE_SHA256_AARCH64_MACOS_CECORE="0522081af302ab41adf05dd1e701afc22fe2e059aa37e6722ce3e486577aa303"

# The three GUI installers (pinned since v0.7.3 — acf2095, the commit
# that first committed them; the version these
# pins measure is CE_MANIFEST_VERSION above — no second copy of it
# here to rot): the highest-privilege artifacts in the release —
# elevated, and the Windows one edits the machine PATH — were the only
# assets with no committed pin, checked solely against a SHA256SUMS
# generated by the same mutable draft. The tag phase now verifies
# these too, so the trust anchor covers all nine binaries.
CE_SHA256_X86_64_WINDOWS_SETUP="eea51639b84fe55865c735a84a4bae3db158736eca542826f2d9878d5a045cf6"
CE_SHA256_X86_64_LINUX_APPIMAGE="b13b556498950c982f50349b7059e646b52983c50d7b1f282b515d0630cbde7c"
CE_SHA256_AARCH64_MACOS_DMG="cd9f31255fd5cba8f66b2ec6491ead47287d1d74e8b49c433d3bb5cf7ac1ff75"
